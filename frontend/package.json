{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true .",
    "preview": "vite preview",
    "generate-client": "openapi-ts",
    "lint:fix": "biome check --apply --no-errors-on-unmatched --files-ignore-unknown=true .",
    "test": "playwright test",
    "test:e2e": "playwright test --fail-on-flaky-tests"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.8.0",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.28.14",
    "@tanstack/react-query-devtools": "^5.28.14",
    "@tanstack/react-router": "1.170.42",
    "axios": "1.20.0",
    "form-data": "4.0.6",
    "next-themes": "^0.4.4",
    "react": "^19.3.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.13",
    "react-hook-form": "^7.0.0",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.6.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.0",
    "@tanstack/router-devtools": "1.167.2",
    "@types/node": "^20.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react-swc": "4.3.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.2.2",
    "vite": "8.3.4",
    "@tanstack/router-plugin": "1.168.43"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
