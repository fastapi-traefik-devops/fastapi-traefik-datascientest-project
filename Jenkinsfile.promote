// Trusted, administrator-controlled registry publisher. It never deploys or writes Git.
// The Job DSL loads this local reviewed definition without sandbox; users cannot edit/replay it.
pipeline {
    agent { label 'registry-publisher' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }
    parameters { string(name: 'CI_BUILD', defaultValue: '', description: 'Exact app-ci/main build number with successful CI gates') }
    environment { REGISTRY_NAMESPACE = 'ghcr.io/fastapi-traefik-devops' }
    stages {
        stage('Verify source CI status') {
            steps {
                script {
                    if (!(params.CI_BUILD ==~ /[1-9][0-9]*/)) { error('Exact CI build number required') }
                    def source
                    waitUntil(initialRecurrencePeriod: 5000) {
                        source = sourceBuild(params.CI_BUILD)
                        if (!source.exists) { error('Source CI build does not exist') }
                        return !source.building
                    }
                    if (source.result != 'SUCCESS') { error('Source CI build must be SUCCESS') }
                    def revision = source.revision
                    if (!(revision ==~ /[0-9a-f]{40}/)) { error('Verified SCM revision required') }
                    env.EXPECTED_SOURCE_SHA = revision
                    copyArtifacts projectName: 'app-ci/main', selector: specific(params.CI_BUILD),
                        filter: '.ci-output/*-ci.tar,.ci-output/gates.json,.ci-output/source-sha.txt', target: 'artifacts', fingerprintArtifacts: true
                }
            }
        }
        stage('Publish immutable SHA images') {
            steps {
                lock(resource: 'phase1-ghcr-publish') {
                    withCredentials([usernamePassword(credentialsId: 'ghcr-write', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
                        sh 'python3 /opt/phase1-ci/registry.py artifacts/.ci-output'
                    }
                }
            }
        }
    }
    post {
        success { archiveArtifacts artifacts: 'artifacts/.ci-output/published-images.json', fingerprint: true }
        // cleanup runs after success, so the publication record is archived first.
        cleanup { deleteDir() }
    }
}

// Jenkins model objects (WorkflowRun) cannot be serialized, and waitUntil checkpoints the
// pipeline between polls. Read the build here and keep only plain values in pipeline state.
@NonCPS
def sourceBuild(String number) {
    def run = jenkins.model.Jenkins.get().getItemByFullName('app-ci/main')?.getBuildByNumber(number.toInteger())
    if (run == null) { return [exists: false] }
    return [exists: true, building: run.isBuilding(), result: run.getResult()?.toString(),
            revision: run.getAction(hudson.plugins.git.util.BuildData)?.getLastBuiltRevision()?.getSha1String()]
}
