// Initial K3s cycle only. Install from reviewed source after explicit live approval.
// Observer/acceptance helpers are retained separately; PROD is blocked.
pipeline {
    agent { label 'registry-publisher' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }
    parameters {
        choice(name: 'ACTION', choices: ['publish-only', 'stage'], description: 'Initial checkpoint: no DEV/PROD workflow or observer')
        choice(name: 'SOURCE_JOB', choices: ['app-ci/main', 'migration-ci'], description: 'Allowlisted successful source')
        string(name: 'CI_BUILD', defaultValue: '', description: 'Exact successful candidate build')
    }
    environment { REGISTRY_NAMESPACE = 'ghcr.io/fastapi-traefik-devops' }
    stages {
        stage('Verify source CI status and artifacts') {
            steps {
                script {
                    if (!(params.ACTION in ['publish-only', 'stage']) ||
                        !(params.SOURCE_JOB in ['migration-ci', 'app-ci/main']) ||
                        !(params.CI_BUILD ==~ /[1-9][0-9]*/)) { error('Invalid publisher request') }
                    if (params.ACTION == 'stage' && params.SOURCE_JOB != 'app-ci/main') {
                        error('STAGE requires successful application main CI')
                    }
                    def source
                    waitUntil(initialRecurrencePeriod: 5000) {
                        source = sourceBuild(params.SOURCE_JOB, params.CI_BUILD)
                        if (!source.exists) { error('Source CI build does not exist') }
                        return !source.building
                    }
                    if (source.result != 'SUCCESS' || !(source.revision ==~ /[0-9a-f]{40}/)) {
                        error('Successful source CI with exact revision required')
                    }
                    env.EXPECTED_SOURCE_SHA = source.revision
                    copyArtifacts projectName: params.SOURCE_JOB, selector: specific(params.CI_BUILD),
                        filter: '.ci-output/*-ci.tar,.ci-output/candidate.json,.ci-output/source-sha.txt,.ci-output/*.xml',
                        target: 'artifacts', fingerprintArtifacts: true
                    sh 'python3 /opt/phase1-ci/registry.py artifacts/.ci-output --mode functional --source-job "$SOURCE_JOB" --source-build "$CI_BUILD" --validate-only'
                }
            }
        }
        stage('Publish and update STAGE sequentially') {
            steps {
                lock(resource: 'liora-stage-promotion') {
                    withCredentials([
                        usernamePassword(credentialsId: 'ghcr-write', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN'),
                        usernamePassword(credentialsId: 'gitops-app', usernameVariable: 'GIT_APP_ID', passwordVariable: 'GIT_TOKEN')
                    ]) {
                        sh 'sh /opt/phase1-ci/publisher-action.sh'
                    }
                }
            }
        }
    }
    post {
        always { archiveArtifacts artifacts: 'artifacts/.ci-output/published-images.json,stage-request.json', allowEmptyArchive: true, fingerprint: true }
        cleanup { deleteDir() }
    }
}

@NonCPS
def sourceBuild(String job, String number) {
    def run = jenkins.model.Jenkins.get().getItemByFullName(job)?.getBuildByNumber(number.toInteger())
    if (run == null) { return [exists: false] }
    def revision = job == 'migration-ci' ? run.getAction(hudson.model.ParametersAction)?.getParameter('APP_COMMIT')?.getValue() :
        run.getAction(hudson.plugins.git.util.BuildData)?.getLastBuiltRevision()?.getSha1String()
    return [exists: true, building: run.isBuilding(), result: run.getResult()?.toString(), revision: revision]
}
