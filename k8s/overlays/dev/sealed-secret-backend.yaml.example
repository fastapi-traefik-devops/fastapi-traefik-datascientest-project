# Template only — shows the shape scripts/seal-secrets.sh produces. Not
# applied as-is: kustomization.yaml references sealed-secret-backend.yaml
# (no .example suffix), which must be generated for real before the dev
# overlay can be applied. See README.md's "Secrets" section.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: backend-secrets
  namespace: dev
spec:
  encryptedData:
    SECRET_KEY: <encrypted-by-kubeseal>
    FIRST_SUPERUSER_PASSWORD: <encrypted-by-kubeseal>
    SMTP_PASSWORD: <encrypted-by-kubeseal>
    POSTGRES_PASSWORD: <encrypted-by-kubeseal>
  template:
    metadata:
      name: backend-secrets
      namespace: dev
    type: Opaque
