# Template only — shows the shape scripts/seal-secrets.sh produces. Not
# applied as-is: kustomization.yaml references sealed-secret-db.yaml (no
# .example suffix), which must be generated for real before the prod overlay
# can be applied. See README.md's "Secrets" section.
#
# POSTGRES_PASSWORD must match the value sealed into backend-secrets.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: db-secrets
  namespace: prod
spec:
  encryptedData:
    POSTGRES_PASSWORD: <encrypted-by-kubeseal>
  template:
    metadata:
      name: db-secrets
      namespace: prod
    type: Opaque
