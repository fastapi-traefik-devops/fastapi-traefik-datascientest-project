# Template only — shows the shape scripts/seal-secrets.sh produces. Not
# applied as-is: kustomization.yaml references sealed-secret-frontend.yaml
# (no .example suffix), which must be generated for real before the prod
# overlay can be applied. See README.md's "Secrets" section.
#
# frontend-secrets currently has no keys, so encryptedData is empty.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: frontend-secrets
  namespace: prod
spec:
  encryptedData: {}
  template:
    metadata:
      name: frontend-secrets
      namespace: prod
    type: Opaque
