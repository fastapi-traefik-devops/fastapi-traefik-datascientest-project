# Template only — db-secrets' POSTGRES_PASSWORD must match backend-secrets'.
# Not referenced by any kustomization and never applied as-is. Every overlay
# supplies its own db-secrets via a SealedSecret generated with
# scripts/seal-secrets.sh (see README.md's "Secrets" section).
apiVersion: v1
kind: Secret
metadata:
  name: db-secrets
type: Opaque
stringData:
  POSTGRES_PASSWORD: changethis
