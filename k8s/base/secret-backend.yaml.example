# Template only — lists the keys backend-secrets must contain. Not referenced
# by any kustomization and never applied as-is. Every overlay supplies its
# own backend-secrets via a SealedSecret generated with scripts/seal-secrets.sh
# (see README.md's "Secrets" section).
apiVersion: v1
kind: Secret
metadata:
  name: backend-secrets
type: Opaque
stringData:
  SECRET_KEY: changethis
  FIRST_SUPERUSER_PASSWORD: changethis
  SMTP_PASSWORD: ""
  POSTGRES_PASSWORD: changethis
