# Template only — frontend-secrets currently has no keys. Not referenced by
# any kustomization and never applied as-is. Every overlay supplies its own
# frontend-secrets via a SealedSecret generated with scripts/seal-secrets.sh
# (see README.md's "Secrets" section).
apiVersion: v1
kind: Secret
metadata:
  name: frontend-secrets
type: Opaque
stringData: {}
